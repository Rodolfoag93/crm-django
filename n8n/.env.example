# Copiar a /opt/n8n/.env en el servidor (no commitear valores reales)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambiar_por_password_fuerte
CRM_BOT_USER=bot-whatsapp
CRM_BOT_PASSWORD=cambiar_por_password_del_bot
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_WEBHOOK_URL=https://bot.app.trotacrm.com/webhook/whatsapp

# Meta Cloud API (alternativa a Twilio). Si están definidas, W5 envía vía CRM.
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_CRM_SEND_URL=https://app.trotacrm.com/v1/bot/whatsapp-meta/send/
# Catálogo WhatsApp Business (brincolines)
BOT_WHATSAPP_CATALOG_URL=https://wa.me/c/5213121529952
# Handoff: números que reciben alerta de asesor (coma-separados)
BOT_HANDOFF_PHONES=3121208876,3125500124
# Nunca ignorar ni notificar (números de prueba).
BOT_EXCLUDE_PHONES=
# Extra: el bot no responde a estos (además de empleados CRM)
BOT_IGNORE_PHONES=3125500124
